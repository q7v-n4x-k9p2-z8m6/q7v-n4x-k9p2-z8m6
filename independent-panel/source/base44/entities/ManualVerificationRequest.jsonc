{
  "name": "ManualVerificationRequest",
  "description": "A1 table: manual_verification_requests \u2014 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062a\u0623\u06cc\u06cc\u062f \u062f\u0633\u062a\u06cc \u062b\u0628\u062a\u200c\u0646\u0627\u0645",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "exchange_name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "pending"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "email",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}