{
  "name": "Customer",
  "description": "A1 table: customers \u2014 \u0633\u062a\u0648\u0646 name \u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0628\u0627 \u0646\u0627\u0645 full_name \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f (alias \u0645\u0633\u062a\u0646\u062f)",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "A1: name (NOT NULL)"
    },
    "full_name": {
      "type": "string",
      "description": "Base44 alias for A1 name; \u062f\u0631 UI \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f"
    },
    "mobile": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "exchange_code": {
      "type": "string"
    },
    "account_details": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "opening_balance": {
      "type": "number",
      "default": 0
    },
    "balance_currency": {
      "type": "string",
      "default": "AFN"
    },
    "status": {
      "type": "string",
      "default": "active",
      "enum": [
        "active",
        "inactive",
        "blocked"
      ],
      "enumColors": [
        "green",
        "gray",
        "red"
      ]
    },
    "customer_type": {
      "type": "string",
      "default": "permanent",
      "description": "A1 default: permanent"
    },
    "tazkira_id": {
      "type": "string"
    },
    "national_id": {
      "type": "string",
      "description": "Alias \u0646\u0645\u0627\u06cc\u0634\u06cc \u0628\u0631\u0627\u06cc tazkira_id"
    },
    "customer_group": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    },
    "identity_status": {
      "type": "string",
      "default": "not_verified",
      "enum": [
        "not_verified",
        "verified"
      ],
      "enumColors": [
        "yellow",
        "green"
      ]
    },
    "identity_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Base44-only: \u0646\u0634\u0627\u0646\u0647\u0654 \u062f\u0627\u062f\u0647\u0654 \u0633\u0627\u062e\u062a\u06af\u06cc"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}