{
  "name": "Language",
  "description": "A1 table: languages",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "native_name": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "default": "rtl",
      "enum": [
        "rtl",
        "ltr"
      ],
      "enumColors": [
        "blue",
        "green"
      ]
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "flag_emoji": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name",
    "native_name",
    "direction",
    "sort_order",
    "is_active",
    "is_default"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}