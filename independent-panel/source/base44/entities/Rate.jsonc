{
  "name": "Rate",
  "description": "A1 table: rates \u2014 \u0627\u0631\u0632\u060c \u0646\u0631\u062e \u062e\u0631\u06cc\u062f/\u0641\u0631\u0648\u0634/\u0631\u0648\u0632 \u0648 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0646\u0645\u0627\u06cc\u0634 \u0646\u0631\u062e",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "buy_rate": {
      "type": "number"
    },
    "sell_rate": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "show_to_customer": {
      "type": "boolean",
      "default": true
    },
    "show_to_anonymous": {
      "type": "boolean",
      "default": false
    },
    "show_mobile": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "daily_rate": {
      "type": "number"
    },
    "decimals": {
      "type": "number",
      "default": 2
    },
    "symbol": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "fiat"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "rate_date": {
      "type": "string",
      "format": "date"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "currency",
    "buy_rate",
    "sell_rate"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}