{
  "name": "FiscalPeriod",
  "description": "A1 table: fiscal_periods \u2014 \u062f\u0648\u0631\u0647\u200c\u0647\u0627\u06cc \u0645\u0627\u0644\u06cc",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "period_code": {
      "type": "string"
    },
    "period_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "default": "open",
      "enum": [
        "open",
        "closed"
      ],
      "enumColors": [
        "green",
        "gray"
      ]
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_by": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "period_code",
    "period_name",
    "start_date",
    "end_date",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}