{
  "name": "OnlineProduct",
  "description": "A1 table: online_products \u2014 \u06a9\u0627\u062a\u0627\u0644\u0648\u06af \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0622\u0646\u0644\u0627\u06cc\u0646 (\u0634\u0627\u0631\u0698\u060c \u0628\u0627\u0632\u06cc\u060c \u06a9\u06cc\u0641 \u067e\u0648\u0644)",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "parent_key": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "default": "product"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "original_price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "AFN"
    },
    "amount": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "account_fields": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "name",
    "level",
    "enabled"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
