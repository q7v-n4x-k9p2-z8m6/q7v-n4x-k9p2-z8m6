{
  "name": "LedgerEntry",
  "description": "A1 table: ledger_entries \u2014 \u0633\u062a\u0648\u0646\u200c\u0647\u0627\u06cc debit/credit \u0645\u0631\u062c\u0639 A1 \u0647\u0633\u062a\u0646\u062f\u061b side/amount/value \u067e\u06cc\u0634\u200c\u0646\u0645\u0627\u06cc\u0634\u06cc\u200c\u0627\u0646\u062f",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "debit": {
      "type": "number",
      "default": 0
    },
    "credit": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string"
    },
    "related_type": {
      "type": "string"
    },
    "registered_by": {
      "type": "string"
    },
    "registered_by_user_id": {
      "type": "number"
    },
    "document_id": {
      "type": "number"
    },
    "transfer_id": {
      "type": "number"
    },
    "account_type": {
      "type": "string",
      "default": "suspense"
    },
    "account_id": {
      "type": "string"
    },
    "account_name": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "pair_entry_id": {
      "type": "number"
    },
    "doc_line_no": {
      "type": "number",
      "default": 0
    },
    "deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_by_name": {
      "type": "string"
    },
    "edited": {
      "type": "boolean",
      "default": false
    },
    "edited_date": {
      "type": "string",
      "format": "date-time"
    },
    "edit_note": {
      "type": "string"
    },
    "doc_number": {
      "type": "string",
      "description": "Base44 alias for documents.doc_number"
    },
    "doc_type": {
      "type": "string",
      "description": "Base44 alias for documents.doc_type"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Base44 alias for created_at"
    },
    "side": {
      "type": "string",
      "enum": [
        "debit",
        "credit"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "Base44 projection of debit/credit"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Base44 projection (\u0627\u0631\u0632 \u0631\u062f\u06cc\u0641)"
    },
    "value": {
      "type": "number",
      "default": 0,
      "description": "Base44 projection (\u0627\u0631\u0632\u0634 \u067e\u0627\u06cc\u0647)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Base44-only"
    }
  },
  "required": [
    "account_type",
    "account_name",
    "currency"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}