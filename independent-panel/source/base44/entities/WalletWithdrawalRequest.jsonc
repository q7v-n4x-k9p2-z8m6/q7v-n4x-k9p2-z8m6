{
  "name": "WalletWithdrawalRequest",
  "description": "A1 table: wallet_withdrawal_requests",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "wallet_id": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "AFN"
    },
    "method": {
      "type": "string",
      "default": "bank_transfer"
    },
    "destination": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "pending"
    },
    "reject_reason": {
      "type": "string"
    },
    "reviewer_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "review_date": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "amount",
    "currency",
    "method",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}