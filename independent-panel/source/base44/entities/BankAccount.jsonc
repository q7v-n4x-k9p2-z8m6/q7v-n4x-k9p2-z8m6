{
  "name": "BankAccount",
  "description": "A1 table: bank_accounts \u2014 \u0645\u0627\u0646\u062f\u0647 \u062c\u0627\u0631\u06cc \u062f\u0631 \u0633\u062a\u0648\u0646 balance \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_number": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "holder": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "sheba": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "opening_balance": {
      "type": "number",
      "default": 0,
      "description": "Base44-only alias\u061b A1 \u0645\u0648\u062c\u0648\u062f\u06cc \u0622\u063a\u0627\u0632\u06cc\u0646 \u0631\u0627 \u062f\u0631 documents/ledger \u062b\u0628\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f"
    },
    "opening_value": {
      "type": "number",
      "default": 0,
      "description": "Base44-only"
    },
    "note": {
      "type": "string",
      "description": "Base44 alias for A1 notes"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Base44-only"
    }
  },
  "required": [
    "bank_name",
    "account_number",
    "currency",
    "active"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}