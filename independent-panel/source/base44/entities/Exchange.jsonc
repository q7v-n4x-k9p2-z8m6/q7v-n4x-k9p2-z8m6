{
  "name": "Exchange",
  "description": "A1 table: exchanges (tenant/\u0635\u0631\u0627\u0641\u06cc) \u2014 quota, plan, referral and trial columns included",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "exchange_name": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "active"
    },
    "password": {
      "type": "string",
      "description": "\u062f\u0631 A1 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f\u061b \u062f\u0631 \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0647\u0631\u06af\u0632 \u0645\u0642\u062f\u0627\u0631 \u0648\u0627\u0642\u0639\u06cc \u0630\u062e\u06cc\u0631\u0647 \u0646\u0634\u0648\u062f"
    },
    "referral_enabled": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string"
    },
    "referral_count": {
      "type": "number",
      "default": 0
    },
    "paid_referral_count": {
      "type": "number",
      "default": 0
    },
    "referral_bonus_quota": {
      "type": "number",
      "default": 0
    },
    "trial_start_date": {
      "type": "string",
      "format": "date"
    },
    "plan": {
      "type": "string",
      "default": "free"
    },
    "payment_status": {
      "type": "string",
      "default": "none"
    },
    "paid_start_date": {
      "type": "string",
      "format": "date"
    },
    "paid_end_date": {
      "type": "string",
      "format": "date"
    },
    "quota_limit": {
      "type": "number",
      "default": 100
    },
    "quota_used": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "exchange_code",
    "exchange_name",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}