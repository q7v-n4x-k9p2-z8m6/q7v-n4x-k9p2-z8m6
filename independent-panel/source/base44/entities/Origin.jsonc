{
  "name": "Origin",
  "description": "A1 table: origins \u2014 \u0646\u0645\u0627\u06cc\u0646\u062f\u06af\u06cc \u0648 \u0645\u0628\u062f\u0623 \u062d\u0648\u0627\u0644\u0647 (Basic/Agent) \u0628\u0627 \u0631\u0627\u0628\u0637\u0647\u0654 \u062e\u0648\u062f\u0627\u0631\u062c\u0627\u0639 agent_id",
  "type": "object",
  "properties": {
    "exchange_code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "origin"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "agent_id": {
      "type": "number",
      "description": "FK origins(id) \u0647\u0645\u0631\u0627\u0647 exchange_code"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}