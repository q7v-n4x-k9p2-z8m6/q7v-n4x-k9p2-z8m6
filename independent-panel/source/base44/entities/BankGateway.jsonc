{
  "name": "BankGateway",
  "description": "A1 table: bank_gateways \u2014 \u062a\u0639\u0631\u06cc\u0641 \u062f\u0631\u06af\u0627\u0647 \u0628\u0627\u0646\u06a9\u06cc",
  "type": "object",
  "properties": {
    "gateway_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "default": "bank_gateway"
    },
    "currency": {
      "type": "string",
      "default": "AFN"
    },
    "merchant_id": {
      "type": "string"
    },
    "callback_url": {
      "type": "string"
    },
    "webhook_url": {
      "type": "string"
    },
    "secret_ref": {
      "type": "string"
    },
    "min_amount": {
      "type": "number",
      "default": 0
    },
    "max_amount": {
      "type": "number",
      "default": 0
    },
    "fee_percent": {
      "type": "number",
      "default": 0
    },
    "fee_fixed": {
      "type": "number",
      "default": 0
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "default": "pending"
    },
    "test_mode": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "gateway_key",
    "name",
    "provider",
    "currency",
    "active",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}